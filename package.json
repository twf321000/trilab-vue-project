    "preview": "vite preview",
    "prepare": "husky install"
  },
  "dependencies": {
    "axios": "^1.7.3",
    "dayjs": "^1.11.12",
    "echarts": "^5.5.1",
    "echarts-gl": "^2.0.9",
    "echarts-wordcloud": "^2.1.0",
    "element-plus": "^2.8.0",
    "jquery": "^3.7.1",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^2.3.1",
    "qrcode": "^1.5.4",
    "qs": "^6.13.0",
    "spark-md5": "^3.0.2",
    "swiper": "^11.1.9",
    "tinymce": "^7.3.0",
    "ts-md5": "^1.3.1",
    "vue": "^3.4.37",
    "vue-router": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@vitejs/plugin-vue": "^5.1.2",
    "@vitejs/plugin-vue-jsx": "^4.0.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "globals": "^15.9.0",
    "husky": "^9.1.4",
    "lint-staged": "^15.2.8",
    "postcss": "^8.4.41",
    "postcss-html": "^1.7.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.3.3",
